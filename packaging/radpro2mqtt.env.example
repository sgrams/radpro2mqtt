# Install as /etc/radpro2mqtt.env, owned by root with mode 0600: it holds the
# broker password, and this keeps it out of the process arguments and shell
# history.

# Prefer a by-id path: /dev/ttyACM0 can renumber across reboots and replugs.
# Find yours with: ls -l /dev/serial/by-id/
RADPRO_PORT=/dev/serial/by-id/usb-Gissio_Rad_Pro_XXXXXXXX-if00

MQTT_URL=mqtt://broker.lan:1883
MQTT_USERNAME=geiger
MQTT_PASSWORD=changeme

# Unique per counter if you run more than one instance.
MQTT_CLIENT_ID=radpro2mqtt

# Any remaining flags, for example: --interval 30 --retain --node-id garage
#
# systemd splits this on whitespace when it expands, so no value here may
# contain a space. Values above are passed literally and have no such limit,
# which is where a password with spaces, '#' or '$' belongs.
RADPRO_ARGS=
